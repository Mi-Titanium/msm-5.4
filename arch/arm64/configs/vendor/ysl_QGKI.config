# Android
CONFIG_ION_MSM_HEAPS=y

# Arch
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_MSM8953=y

# CPU idle
CONFIG_ARM_CPUIDLE=n
CONFIG_ARM_QCOM_LPM_CPUIDLE=y
 
# devfreq
CONFIG_DEVFREQ_SIMPLE_DEV=y
# msm_bus drivers/devfreq/ CONFIG_QCOM_DEVFREQ_DEVBW=y

# DMA
CONFIG_QCOM_SPS_DMA=y

# Energy model
CONFIG_LEGACY_ENERGY_MODEL_DT=y
 
# Firmware
CONFIG_QCOM_SCM=y
CONFIG_QTI_TZ_LOG=y
 
# GPU
CONFIG_DRM=n
CONFIG_QCOM_QFPROM=y
CONFIG_QCOM_KGSL=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y

# HW Spinlock
CONFIG_HWSPINLOCK_QCOM=y
 
# I2C
CONFIG_I2C_MSM_V2=y
 
# Input
CONFIG_INPUT_QPNP_POWER_ON=y

# IOMMU
CONFIG_IOMMU_DYNAMIC_DOMAINS=y
CONFIG_IOMMU_IO_PGTABLE_FAST=y
CONFIG_QCOM_IOMMU_IO_PGTABLE_QUIRKS=y
CONFIG_QTI_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_LAZY_MAPPING=y
 
# IRQ chip
CONFIG_QCOM_MPM=y

# MFD
CONFIG_MFD_SPMI_PMIC=y

# Platform
CONFIG_SPS=y
CONFIG_SPS_SUPPORT_NDP_BAM=y
CONFIG_QPNP_REVID=y

# Power
CONFIG_POWER_RESET_MSM=y

# Serial console
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_MSM_HS=y

# SoC
CONFIG_QCOM_DCC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_MSM_BOOT_STATS=y
CONFIG_QCOM_WDT_CORE=y
CONFIG_QCOM_SOC_WATCHDOG=y
CONFIG_MSM_CORE_HANG_DETECT=y
#CONFIG_QCOM_SMP2P=y
#CONFIG_QCOM_SMP2P_SLEEPSTATE=y
#CONFIG_QCOM_SMSM=y
CONFIG_MSM_SPM=y
CONFIG_QCOM_BUS_SCALING=y
CONFIG_MSM_TZ_SMMU=y
CONFIG_MSM_PM=y
CONFIG_QGKI=y
CONFIG_QCOM_RTIC=n
CONFIG_QTI_RPM_STATS_LOG=y
CONFIG_QCOM_SECURE_BUFFER=y

# SPMI
CONFIG_SPMI_MSM_PMIC_ARB=y

# Localversion
CONFIG_LOCALVERSION="-Mi-Titanium-Bringup"
CONFIG_LOCALVERSION_AUTO=n

# Panic
CONFIG_PANIC_TIMEOUT=1
 
# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_LZ4_COMPRESS=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Ramdisk
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
 
# Reduce size
CONFIG_SLUB_DEBUG=n

# Mach
CONFIG_MACH_XIAOMI_YSL=y